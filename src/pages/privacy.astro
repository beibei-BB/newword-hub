---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title={`Privacy | ${site.name}`} description="Read how this site handles information."><h1>Privacy</h1><p>Tools may process the information you enter in your browser. Please check each tool's description for details.</p><p>When enabled, analytics and advertising providers may collect usage data or use cookies. Contact us at <a href={`mailto:${site.email}`}>{site.email}</a> with questions.</p><p>This is placeholder text; update it to reflect actual services and practices before launch.</p></Base>
