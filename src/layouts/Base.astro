---
import { site } from '../site.config';
const { title, description } = Astro.props;
const canonical = site.domain ? new URL(Astro.url.pathname, site.domain).href : null;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/>{!site.domain && <meta name="robots" content="noindex, nofollow"/>}{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{canonical && <meta property="og:url" content={canonical}/>}<meta property="og:site_name" content={site.name}/>{site.cloudflareAnalyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token: site.cloudflareAnalyticsToken})}></script>}<style is:global define:vars={{primary:site.color}}>
:root{font-family:system-ui,sans-serif;color:#172033;line-height:1.5}body{margin:0}a{color:var(--primary)}header,main,footer{max-width:960px;margin:auto;padding:1rem}header,footer{display:flex;gap:1rem;flex-wrap:wrap}header a:first-child{font-weight:700;margin-right:auto}main{min-height:60vh}h1{line-height:1.15}button{background:var(--primary);color:white;border:0;border-radius:4px;padding:.7rem 1rem;cursor:pointer}input,textarea{box-sizing:border-box;width:100%;padding:.6rem;font:inherit}label{display:block;margin:.7rem 0}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}.card{border:1px solid #ddd;padding:1rem;border-radius:5px}.tool{border:1px solid #ddd;padding:1rem;border-radius:5px}.tool textarea{min-height:70px}.actions{display:flex;gap:.5rem;flex-wrap:wrap}.ad{margin:1rem 0}footer{border-top:1px solid #ddd}
</style></head><body><header><a href="/">{site.name}</a><a href="/blog/">Blog</a><a href="/about/">About</a><a href="/contact/">Contact</a></header><main><slot/></main><footer><a href="/privacy/">Privacy</a><a href="/about/">About</a><a href="/contact/">Contact</a></footer></body></html>
